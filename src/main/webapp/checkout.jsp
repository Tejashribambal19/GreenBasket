<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*,java.math.*,com.mycompany.greenbasket.*" %><%UserReg cu=(UserReg)session.getAttribute("loggedUser");if(cu==null){response.sendRedirect("UserLogin.jsp?checkout=1");return;}Map<Integer,Integer> cc=(Map<Integer,Integer>)session.getAttribute("cart");if(cc==null||cc.isEmpty()){response.sendRedirect("products.jsp");return;}ProductDAO cdao=new ProductDAO();BigDecimal ctotal=BigDecimal.ZERO;for(var e:cc.entrySet()){Product p=cdao.getById(e.getKey());if(p!=null)ctotal=ctotal.add(p.getPrice().multiply(BigDecimal.valueOf(e.getValue())));}%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="container"><div class="page-head"><span class="eyebrow">Secure checkout</span><h1 style="margin-top:14px">Confirm your delivery details.</h1></div><div class="cart-layout"><section class="panel" style="margin:0"><h2>Delivery information</h2><%if(request.getAttribute("errorMessage")!=null){%><div class="message error"><%=request.getAttribute("errorMessage")%></div><%}%><form action="CheckoutServlet" method="post"><div class="field"><label>Deliver to</label><input value="<%=cu.getName()%>" disabled></div><div class="field"><label>Delivery address</label><textarea name="address" required><%=cu.getAdd()%>, <%=cu.getCity()%>, <%=cu.getState()%></textarea></div><div class="notice">This project checkout places the order directly. Payment gateway integration can be added later without changing the product or order structure.</div><button class="btn btn-primary" style="margin-top:18px">Place order →</button></form></section><aside class="summary-box"><h3>Order total</h3><div class="summary-line"><span>Items</span><span><%=cc.size()%></span></div><div class="summary-line summary-total"><span>Total</span><span>₹<%=ctotal%></span></div></aside></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
