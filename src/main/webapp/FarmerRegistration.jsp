<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farmer Registration | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">Sell on GreenBasket</span><h2 style="margin-top:18px">Turn your farm into a trusted digital storefront.</h2><p>Create the farmer profile first. Products and verification are managed after login.</p><div class="quote">Categories belong to products—not the farmer account—so one farm can sell across multiple organic categories.</div></div><div class="auth-form"><h1>Create farmer account</h1><p class="sub">Set up your farm identity.</p><% if(request.getAttribute("errorMessage")!=null){%><div class="message error"><%=request.getAttribute("errorMessage")%></div><%}%><form action="FarmerRegistrationServlet" method="post"><div class="field-grid"><div class="field"><label>Farmer name</label><input name="name" required></div><div class="field"><label>Farm name</label><input name="farmName" required></div><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Mobile</label><input name="mob" pattern="[0-9]{10}" required></div><div class="field"><label>Password</label><input type="password" name="password" minlength="4" required></div><div class="field"><label>Gender</label><select name="gender" required><option value="">Select</option><option>Female</option><option>Male</option><option>Other</option></select></div><div class="field full"><label>Farm / contact address</label><textarea name="address" required></textarea></div><div class="field"><label>City</label><input name="city" required></div><div class="field"><label>State</label><input name="state" value="Maharashtra" required></div></div><button class="btn btn-primary" type="submit">Create farmer profile →</button></form><div class="helper">Already registered? <a href="FarmerLogin.jsp">Farmer sign in</a></div></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
