<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="com.mycompany.greenbasket.*" %><%int id=Integer.parseInt(request.getParameter("id"));Farmer ef=new FarmerDAO().getFarmerById(id);if(ef==null){response.sendRedirect("welcomeFarmer.jsp");return;}%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Update Farmer Profile | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">Farmer profile</span><h2 style="margin-top:18px">Keep your farm identity accurate.</h2><p>These details appear across the seller experience and support product trust.</p></div><div class="auth-form"><h1>Update farm profile</h1><form action="UpdateFarmerServlet" method="post"><input type="hidden" name="id" value="<%=ef.getId()%>"><div class="field-grid"><div class="field"><label>Farmer name</label><input name="name" value="<%=ef.getName()%>" required></div><div class="field"><label>Farm name</label><input name="farmName" value="<%=ef.getFarmName()%>" required></div><div class="field"><label>Email</label><input type="email" name="email" value="<%=ef.getEmail()%>" required></div><div class="field"><label>Mobile</label><input name="mob" value="<%=ef.getMob()%>" required></div><div class="field"><label>Password</label><input type="password" name="password" value="<%=ef.getPassword()%>" required></div><div class="field"><label>Gender</label><input name="gender" value="<%=ef.getGender()%>" required></div><div class="field full"><label>Address</label><textarea name="address" required><%=ef.getAddress()%></textarea></div><div class="field"><label>City</label><input name="city" value="<%=ef.getCity()%>" required></div><div class="field"><label>State</label><input name="state" value="<%=ef.getState()%>" required></div></div><button class="btn btn-primary">Save changes</button></form></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
