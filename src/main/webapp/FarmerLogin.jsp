<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farmer Login | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">Farmer Studio</span><h2 style="margin-top:18px">Your harvest deserves a better storefront.</h2><p>Manage listings, stock and verification from one focused farmer workspace.</p><div class="quote">GreenBasket separates the seller experience from the buyer storefront so each side stays simple.</div></div><div class="auth-form"><h1>Farmer sign in</h1><p class="sub">Access your GreenBasket seller studio.</p><% if(request.getAttribute("errorMessage")!=null){%><div class="message error"><%=request.getAttribute("errorMessage")%></div><%}%><form action="FarmerLoginServlet" method="post"><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn btn-primary" type="submit">Open Farmer Studio →</button></form><div class="helper">New farmer? <a href="FarmerRegistration.jsp">Create a farmer account</a></div></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
