<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*,java.math.*,com.mycompany.greenbasket.*" %><%Map<Integer,Integer> cart=(Map<Integer,Integer>)session.getAttribute("cart");if(cart==null)cart=new LinkedHashMap<>();ProductDAO cpd=new ProductDAO();BigDecimal total=BigDecimal.ZERO;%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your Basket | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="container"><div class="section-head"><div><span class="eyebrow">Your basket</span><h2 style="margin-top:14px">A fresh basket, ready when you are.</h2></div><a class="btn btn-outline" href="products.jsp">← Keep shopping</a></div><%if(cart.isEmpty()){%><div class="empty"><div style="font-size:48px">🧺</div><h3>Your basket is empty</h3><p>Browse the organic marketplace and add something fresh.</p><a class="btn btn-primary" href="products.jsp">Shop organic</a></div><%}else{%><div class="cart-layout"><section class="panel" style="margin:0"><%for(var e:cart.entrySet()){Product p=cpd.getById(e.getKey());if(p==null)continue;BigDecimal line=p.getPrice().multiply(BigDecimal.valueOf(e.getValue()));total=total.add(line);%><div class="cart-item"><div class="cart-thumb">🌿</div><div><strong><%=p.getName()%></strong><div style="color:#68756d;font-size:13px"><%=p.getFarmName()%> · ₹<%=p.getPrice()%> / <%=p.getUnit()%></div><form action="CartServlet" method="post" style="display:flex;gap:8px;margin-top:8px"><input type="hidden" name="productId" value="<%=p.getId()%>"><input style="width:70px;padding:7px;border:1px solid #ccd9cf;border-radius:10px" type="number" name="quantity" min="1" max="<%=p.getStock()%>" value="<%=e.getValue()%>"><button class="btn btn-soft" style="padding:7px 12px">Update</button></form></div><div style="text-align:right"><strong>₹<%=line%></strong><form action="CartServlet" method="post"><input type="hidden" name="productId" value="<%=p.getId()%>"><input type="hidden" name="action" value="remove"><button class="btn btn-danger" style="margin-top:8px;padding:7px 11px">Remove</button></form></div></div><%}%></section><aside class="summary-box"><h3>Basket summary</h3><div class="summary-line"><span>Subtotal</span><strong>₹<%=total%></strong></div><div class="summary-line"><span>Delivery</span><span>Calculated at checkout</span></div><div class="summary-line summary-total"><span>Total</span><span>₹<%=total%></span></div><a class="btn btn-gold" style="width:100%;margin-top:18px" href="checkout.jsp">Continue to checkout →</a></aside></div><%}%></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
