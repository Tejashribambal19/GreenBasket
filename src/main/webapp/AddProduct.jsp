<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*,com.mycompany.greenbasket.*" %><%Farmer f=(Farmer)session.getAttribute("loggedFarmer");if(f==null){response.sendRedirect("FarmerLogin.jsp");return;}List<Category> cats2=new ProductDAO().getCategories();%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Add Product | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">New listing</span><h2 style="margin-top:18px">Present your harvest with clarity.</h2><p>Choose one of GreenBasket's organic categories and add accurate price, stock and unit details.</p><div class="quote">Tip: add your own real product photo URL if available. If it is blank or broken, GreenBasket automatically tries a product-specific real photo and then a local fallback.</div></div><div class="auth-form"><h1>Add product</h1><p class="sub">Listing for <strong><%=f.getFarmName()%></strong></p><%if(request.getAttribute("errorMessage")!=null){%><div class="message error"><%=request.getAttribute("errorMessage")%></div><%}%><form action="AddProductServlet" method="post"><div class="field"><label>Category</label><select name="categoryId" required><option value="">Select category</option><%for(Category c:cats2){%><option value="<%=c.getId()%>"><%=c.getIcon()%> <%=c.getName()%></option><%}%></select></div><div class="field"><label>Product name</label><input name="name" placeholder="e.g. Organic Tomatoes" required></div><div class="field"><label>Description</label><textarea name="description" placeholder="Freshly harvested, growing method, quality notes..."></textarea></div><div class="field-grid"><div class="field"><label>Price (₹)</label><input name="price" type="number" min="0" step="0.01" required></div><div class="field"><label>Stock quantity</label><input name="stock" type="number" min="0" required></div><div class="field"><label>Unit</label><select name="unit"><option value="kg">kg</option><option value="500 g">500 g</option><option value="250 g">250 g</option><option value="piece">piece</option><option value="dozen">dozen</option><option value="litre">litre</option><option value="pack">pack</option></select></div><div class="field"><label>Image URL (optional)</label><input name="imageUrl" type="url" placeholder="https://..."></div></div><button class="btn btn-primary">Publish product →</button></form></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
