<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*,com.mycompany.greenbasket.*" %><%UserReg u=(UserReg)session.getAttribute("loggedUser");if(u==null){response.sendRedirect("UserLogin.jsp");return;}List<String[]> recentOrders=new OrderDAO().getOrdersForUser(u.getId());%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My GreenBasket | Buyer</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><div class="dashboard"><aside class="sidebar"><div class="profile"><div class="avatar"><%=u.getName().substring(0,1).toUpperCase()%></div><h3><%=u.getName()%></h3><small>GreenBasket buyer</small></div><nav class="side-links"><a class="active" href="welcomeUser.jsp">▦ Overview</a><a href="products.jsp">🧺 Shop organic</a><a href="cart.jsp">🛒 Cart</a><a href="orders.jsp">📦 Orders</a><a href="UpdateUser.jsp?id=<%=u.getId()%>">⚙ Profile</a><a href="LogoutServlet">↗ Sign out</a></nav></aside><main class="dash-main"><section class="dash-hero"><span class="eyebrow">Buyer space</span><h1>Hello, <%=u.getName()%>.</h1><p>Discover organic products, manage your basket and keep track of your orders.</p></section><div class="stats"><div class="stat"><span>Orders</span><strong><%=recentOrders.size()%></strong></div><div class="stat"><span>City</span><strong style="font-size:20px"><%=u.getCity()%></strong></div><div class="stat"><span>Member type</span><strong style="font-size:20px">Buyer</strong></div></div><section class="panel"><div class="panel-head"><h2>Start shopping</h2><a class="btn btn-primary" href="products.jsp">Browse marketplace →</a></div><p style="color:#68756d">Explore vegetables, fruits, grains, pulses, spices, dairy, nuts, oils and natural sweeteners—all within GreenBasket's organic-only marketplace.</p></section><section class="panel"><div class="panel-head"><h2>Recent orders</h2><a class="btn btn-outline" href="orders.jsp">View all</a></div><%if(recentOrders.isEmpty()){%><div class="empty"><p>No orders yet. Your first basket is waiting.</p></div><%}else{%><div class="table-wrap"><table class="data-table"><thead><tr><th>Order</th><th>Total</th><th>Status</th><th>Date</th><th>Feedback</th></tr></thead><tbody><%for(String[] o:recentOrders.subList(0,Math.min(4,recentOrders.size()))){%><tr><td>#<%=o[0]%></td><td>₹<%=o[1]%></td><td><span class="status APPROVED"><%=o[2]%></span></td><td><%=o[4]%></td><td><a class="btn btn-soft btn-compact" href="feedback.jsp?orderId=<%=o[0]%>">★ Rate</a></td></tr><%}%></tbody></table></div><%}%></section></main></div><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
