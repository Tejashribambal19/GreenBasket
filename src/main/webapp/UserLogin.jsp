<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Buyer Login | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">Buyer account</span><h2 style="margin-top:18px">Your organic basket starts here.</h2><p>Sign in to save a cart, place orders and keep your purchase history together.</p><div class="quote">Browse freely. Sign in only when you are ready to order.</div></div><div class="auth-form"><h1>Welcome back</h1><p class="sub">Sign in to your GreenBasket buyer account.</p><% if(request.getAttribute("errorMessage")!=null){%><div class="message error"><%=request.getAttribute("errorMessage")%></div><%}%><form action="Userloginservlet" method="post"><div class="field"><label>Email address</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn btn-primary" type="submit">Sign in →</button></form><div class="helper">New to GreenBasket? <a href="UserRegistration.jsp">Create a buyer account</a></div></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
