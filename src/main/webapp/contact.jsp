<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">We’re listening</span><h2 style="margin-top:18px">Questions, feedback or a farming partnership?</h2><p>Send a message and keep the conversation around organic food moving.</p><div class="quote">GreenBasket is designed as a direct bridge between local growers and conscious buyers.</div></div><div class="auth-form"><h1>Contact GreenBasket</h1><p class="sub">Tell us what you need.</p><% if("1".equals(request.getParameter("sent"))){%><div class="message success">Thank you. Your message has been received.</div><%}%><form action="ContactServlet" method="post"><div class="field"><label>Name</label><input name="firstname" required></div><div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Message</label><textarea name="subject" required></textarea></div><button class="btn btn-primary" type="submit">Send message →</button></form></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
