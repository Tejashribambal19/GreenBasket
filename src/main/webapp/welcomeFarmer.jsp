<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.*,com.mycompany.greenbasket.*" %><%Farmer f=(Farmer)session.getAttribute("loggedFarmer");if(f==null){response.sendRedirect("FarmerLogin.jsp");return;}ProductDAO fd=new ProductDAO();List<Product> mine=fd.getByFarmer(f.getId());String verify=fd.verificationStatus(f.getId());int stock=0;for(Product p:mine)stock+=p.getStock();%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farmer Studio | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><div class="dashboard"><aside class="sidebar"><div class="profile"><div class="avatar"><%=f.getName().substring(0,1).toUpperCase()%></div><h3><%=f.getName()%></h3><small><%=f.getFarmName()%></small></div><nav class="side-links"><a class="active" href="welcomeFarmer.jsp">▦ Overview</a><a href="AddProduct.jsp">＋ Add product</a><a href="#verification">✓ Verification</a><a href="UpdateFarmer.jsp?id=<%=f.getId()%>">⚙ Profile</a><a href="LogoutServlet">↗ Sign out</a></nav></aside><main class="dash-main"><section class="dash-hero"><span class="eyebrow">Farmer Studio</span><h1>Good afternoon, <%=f.getName()%>.</h1><p>Your farm, listings and verification status are all in one place.</p></section><div class="stats"><div class="stat"><span>Products listed</span><strong><%=mine.size()%></strong></div><div class="stat"><span>Total stock units</span><strong><%=stock%></strong></div><div class="stat"><span>Verification</span><strong style="font-size:18px"><span class="status <%=verify%>"><%=verify.replace('_',' ')%></span></strong></div></div><section class="panel"><div class="panel-head"><h2>Your products</h2><a class="btn btn-primary" href="AddProduct.jsp">＋ Add product</a></div><%if(mine.isEmpty()){%><div class="empty"><div style="font-size:42px">🧺</div><h3>Your shelf is ready</h3><p>Add your first organic product to appear in the buyer marketplace.</p><a class="btn btn-primary" href="AddProduct.jsp">Create first listing</a></div><%}else{%><div class="table-wrap"><table class="data-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead><tbody><%for(Product p:mine){%><tr><td><strong><%=p.getName()%></strong></td><td><%=p.getCategoryName()%></td><td>₹<%=p.getPrice()%> / <%=p.getUnit()%></td><td><%=p.getStock()%></td><td><a class="btn btn-danger" data-confirm="Delete this product?" href="DeleteProductServlet?id=<%=p.getId()%>">Delete</a></td></tr><%}%></tbody></table></div><%}%></section><section class="panel" id="verification"><div class="panel-head"><div><h2>Farmer verification</h2><p style="margin:4px 0 0;color:#68756d;font-size:13px">Current status: <span class="status <%=verify%>"><%=verify.replace('_',' ')%></span></p></div></div><form action="VerificationServlet" method="post"><div class="field-grid"><div class="field"><label>Organic certificate / reference number</label><input name="certificateNo" required></div><div class="field"><label>Verification note</label><input name="note" placeholder="Certification body, farm detail, etc."></div></div><button class="btn btn-outline">Submit for admin review</button></form></section></main></div><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
