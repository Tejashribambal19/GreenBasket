<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="com.mycompany.greenbasket.*" %><%int id=Integer.parseInt(request.getParameter("id"));UserReg eu=new UserRegDAO().getUserById(id);if(eu==null){response.sendRedirect("welcomeUser.jsp");return;}%><!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Update Profile | GreenBasket</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/greenbasket.css"></head><body><%@ include file="/WEB-INF/includes/header.jspf" %><main class="page-shell"><div class="auth-layout"><div class="auth-story"><span class="eyebrow">Buyer profile</span><h2 style="margin-top:18px">Keep your account details current.</h2><p>Your delivery information and account profile live here.</p></div><div class="auth-form"><h1>Update profile</h1><form action="UpdateUserServlet" method="post"><input type="hidden" name="id" value="<%=eu.getId()%>"><div class="field-grid"><div class="field full"><label>Name</label><input name="name" value="<%=eu.getName()%>" required></div><div class="field"><label>Email</label><input type="email" name="email" value="<%=eu.getEmail()%>" required></div><div class="field"><label>Mobile</label><input name="mob" value="<%=eu.getMob()%>" required></div><div class="field"><label>Password</label><input type="password" name="password" value="<%=eu.getPassword()%>" required></div><div class="field"><label>Gender</label><input name="gender" value="<%=eu.getGender()%>" required></div><div class="field full"><label>Address</label><textarea name="add" required><%=eu.getAdd()%></textarea></div><div class="field"><label>City</label><input name="city" value="<%=eu.getCity()%>" required></div><div class="field"><label>State</label><input name="state" value="<%=eu.getState()%>" required></div></div><button class="btn btn-primary">Save changes</button></form></div></div></main><%@ include file="/WEB-INF/includes/footer.jspf" %></body></html>
